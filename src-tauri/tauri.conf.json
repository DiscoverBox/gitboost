{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitBoost",
  "version": "0.1.0",
  "identifier": "pro.gitboost.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitBoost",
        "width": 1100,
        "height": 760,
        "minWidth": 920,
        "minHeight": 640,
        "center": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 14, "y": 16 },
        "backgroundColor": "#EEF2F5"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "DeveloperTool",
    "shortDescription": "GitHub 公开 HTTPS 仓库读取加速",
    "longDescription": "保持原始 GitHub 地址不变，通过用户选择的外部节点加速公开 HTTPS 仓库读取。",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
